        "status": "approximate_reference",
        "year": null,
        "scope": "to_be_confirmed_total_or_residential"
      },
      "target": {
        "value": 20000,
        "unit": "kWh/person/year",
        "status": "aspirational",
        "scope": "total_electricity_use_per_capita"
      },
      "multiple": 8.6956521739,
      "source": {
        "name": "World Bank",
        "indicator": "EG.USE.ELEC.KH.PC",
