      "name": "Taxa Selic nominal",
      "baseline": {
        "value": null,
        "unit": "percent_per_year",
        "status": "fetch_observed_value_from_bcb"
      },
      "target": {
        "value": 9.99,
        "unit": "percent_per_year",
        "comparison": "below",
        "status": "single_digit_policy_goal"
      },
      "source": {
